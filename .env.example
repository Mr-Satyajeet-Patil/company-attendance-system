# ==========================================
# PulseAttend 360 AI - Environment Variables
# ==========================================

# Security
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# Timezone (e.g., Asia/Kolkata, America/New_York, UTC)
DJANGO_TIME_ZONE=Asia/Kolkata

# CORS Allowed Origins (Comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Database (Leave blank for SQLite dev, or provide PostgreSQL URL in production)
# DATABASE_URL=postgres://user:password@hostname:5432/pulseattend_db

# Biometric Verification Defaults
FACENET_MATCH_THRESHOLD=0.68
DEFAULT_GRACE_PERIOD_MINS=15
